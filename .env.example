# Portfolio Environment Configuration (Optional)
# Copy this file to .env to configure optional features.

# Optional: Custom endpoint for contact form message delivery (e.g., Formspree, Web3Forms, or custom serverless function)
# Example: VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
VITE_CONTACT_FORM_ENDPOINT=

# Optional: Access key for contact form provider
VITE_CONTACT_FORM_KEY=
